data: {"result":{"tools":[{"name":"add","description":"Adds two numbers","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"a":{"type":"number"},"b":{"type":"number"}},"required":["a","b"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"save_note","description":"Saves a note (changes things)","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"text":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}}},"required":["text"]},"annotations":{"destructiveHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"picture","description":"Returns a picture","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{}},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"big","description":"Returns a lot of text","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"n":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}},"required":["n"]},"annotations":{"readOnlyHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"fails","description":"Always reports an error","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{}},"execution":{"taskSupport":"forbidden"}},{"name":"shape","description":"Takes a nested shape","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"where":{"type":"object","properties":{"city":{"type":"string"},"zip":{"type":["string","null"]}},"required":["city","zip"]},"mode":{"default":"fast","type":"string","enum":["fast","slow"]},"extra":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["where"]},"execution":{"taskSupport":"forbidden"}}]},"jsonrpc":"2.0","id":2}

