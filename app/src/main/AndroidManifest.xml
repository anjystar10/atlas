<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Gemini, Atlas's online brain -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- talking to Atlas, and "Hey Atlas" -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- reminders ring like an alarm, over the lock screen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Lets Atlas see launchable apps so "open whatsapp" works. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Atlas"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The "Hey Atlas" panel: opens over whatever is on screen, even the lock screen. -->
        <activity
            android:name=".AssistActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.anjy.atlas.assist"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <service
            android:name=".AvatarService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Always-on assistant: a creature drawn over other apps and a status pill while it works, at the user's request" />
        </service>

        <!-- The alarm pop-up: rings and asks whether you'll do it. -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.anjy.atlas.alarm"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- A focus session: "I'm doing it now". One screen with a timer; only End closes it. -->
        <activity
            android:name=".FocusActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.anjy.atlas.focus"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- Atlas Bot: its page, the service that keeps Atlas running while a bot works, and its notification keys. -->
        <!-- Atlas Bot's files: the Library, the page viewer, and a private provider for Open / Share (not exported: each
             Open or Share grants read access to that one file only) -->
        <activity
            android:name=".LibraryActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <activity
            android:name=".PageViewActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <provider
            android:name=".BotFileProvider"
            android:authorities="com.anjy.atlas.botfiles"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".BotExtrasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <activity
            android:name=".BotActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <!-- The bot's web browser on screen: watch it, or take over to sign in, then hand back. -->
        <activity
            android:name=".BotBrowserActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <!-- sync while Atlas is closed: about every half hour, when there's a network (Android picks the moment) -->
        <service
            android:name=".SyncJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <service
            android:name=".BotService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Atlas Bot: finishes a multi-step job the user asked the assistant to do (research, writing, phone actions) while they use other apps" />
        </service>
        <receiver android:name=".BotReceiver" android:exported="false" />

        <!-- "Hey Atlas" listens in its own process, so a crash in the speech engine can't close Atlas. -->
        <service
            android:name=".HotwordService"
            android:exported="false"
            android:process=":hotword"
            android:foregroundServiceType="microphone" />

        <!-- The offline model runs in its own process: running out of memory there can't close Atlas. -->
        <service
            android:name=".ModelService"
            android:exported="false"
            android:process=":brain" />

        <!-- Phone control: lets Atlas read the screen and tap, type and scroll when the user asks it to. -->
        <service
            android:name=".AtlasAccess"
            android:exported="false"
            android:label="Atlas"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/atlas_access" />
        </service>

        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".PingReceiver" android:exported="false" />
        <receiver android:name=".RoutineReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
