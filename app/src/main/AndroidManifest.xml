<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Gemini, Atlas's online brain -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- talking to Atlas, and "Hey Atlas" -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- reminders ring like an alarm, over the lock screen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- the phone's calendar, contacts, location and Clock app (asked for only when first used) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- background first: texts are sent only after the user OKs each one (Messages.kt) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- the vault shows a saved password only after the phone's own unlock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Lets Atlas see launchable apps so "open whatsapp" works. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- the Clock app, for phone_alarm and phone_timer -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
    </queries>

    <application
        android:name=".AtlasApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Atlas"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The "Hey Atlas" panel: opens over whatever is on screen, even the lock screen. -->
        <activity
            android:name=".AssistActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.anjy.atlas.assist"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AtlasSheet"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- The assist gesture / assistant button: opens the mini panel over the app in front (never the full app). -->
        <activity
            android:name=".AssistEntry"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.anjy.atlas.assist"
            android:theme="@style/AtlasSheet">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".AvatarService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Always-on assistant: a creature drawn over other apps and a status pill while it works, at the user's request" />
        </service>

        <!-- The alarm pop-up: rings and asks whether you'll do it. -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.anjy.atlas.alarm"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- A focus session: "I'm doing it now". One screen with a timer; only End closes it. -->
        <activity
            android:name=".FocusActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.anjy.atlas.focus"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- Atlas Bot: its page, the service that keeps Atlas running while a bot works, and its notification keys. -->
        <!-- Atlas Bot's files: the Library, the page viewer, and a private provider for Open / Share (not exported: each
             Open or Share grants read access to that one file only) -->
        <activity
            android:name=".LibraryActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <activity
            android:name=".PageViewActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <!-- Snap: the camera app writes one photo or video into Atlas through this (not exported; access per capture) -->
        <provider
            android:name=".SnapProvider"
            android:authorities="com.anjy.atlas.snap"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name=".BotFileProvider"
            android:authorities="com.anjy.atlas.botfiles"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".BotExtrasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <activity
            android:name=".BotActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <!-- The bot's web browser on screen: watch it, or take over to sign in, then hand back. -->
        <activity
            android:name=".BotBrowserActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <!-- sync while Atlas is closed: about every half hour, when there's a network (Android picks the moment) -->
        <service
            android:name=".SyncJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <service
            android:name=".BotService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Atlas Bot: finishes a multi-step job the user asked the assistant to do (research, writing, phone actions) while they use other apps" />
        </service>
        <receiver android:name=".BotReceiver" android:exported="false" />
        <!-- Device Link: your laptop reaching this phone (tasks, and controlling it once you allow) while Atlas is closed -->
        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Device Link: keeps a connection to the user's own computer so it can send the assistant tasks and, when the user allows it, view and control this phone" />
        </service>
        <receiver android:name=".LinkReceiver" android:exported="false" />
        <receiver android:name=".TradingReceiver" android:exported="false" />
        <activity
            android:name=".LaptopActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <activity
            android:name=".PermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- "Hey Atlas" listens in its own process, so a crash in the speech engine can't close Atlas. -->
        <service
            android:name=".HotwordService"
            android:exported="false"
            android:process=":hotword"
            android:foregroundServiceType="microphone" />

        <!-- The offline model runs in its own process: running out of memory there can't close Atlas. -->
        <service
            android:name=".ModelService"
            android:exported="false"
            android:process=":brain" />

        <!-- Phone control: lets Atlas read the screen and tap, type and scroll when the user asks it to. -->
        <service
            android:name=".AtlasAccess"
            android:exported="false"
            android:label="Atlas"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/atlas_access" />
        </service>

        <!-- >>> background first: notification replies, permission asks, the screen heads-up (Messages.kt, PermissionCenter.kt, ScreenGate.kt) -->
        <service
            android:name=".AtlasNotifs"
            android:exported="true"
            android:label="Atlas"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity android:name=".PermissionAskActivity" android:exported="false" android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".PermissionsActivity" android:exported="false" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <receiver android:name=".ScreenReceiver" android:exported="false" />
        <!-- <<< background first -->
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".PingReceiver" android:exported="false" />
        <receiver android:name=".RoutineReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
