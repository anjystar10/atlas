+// Atlas patch: format with the model's own (Jinja) chat template, with thinking switched off, so models whose
+// format isn't in llama.cpp's built-in list (e.g. Gemma 4) work, and hybrid models (e.g. Qwen3.5) answer directly.
+// Falls back to the built-in formats if the template can't be rendered.
+static std::string atlas_format_single(const std::vector<common_chat_msg> &past, const common_chat_msg &new_msg,
+                                       bool add_ass, bool use_jinja) {
+    const auto *tmpls = g_chat_templates.get();
+    common_chat_templates_inputs inputs;
+    inputs.use_jinja = use_jinja;
+    inputs.enable_thinking = false;
+    inputs.chat_template_kwargs["enable_thinking"] = "false";
+    std::string fmt_past;
+    if (!past.empty()) {
+        inputs.messages = past;
+        inputs.add_generation_prompt = false;
+        fmt_past = common_chat_templates_apply(tmpls, inputs).prompt.str();
+    }
+    std::ostringstream ss;
+    if (add_ass && !fmt_past.empty() && fmt_past.back() == '\n') ss << "\n";
+    inputs.messages.push_back(new_msg);
+    inputs.add_generation_prompt = add_ass;
+    auto fmt_new = common_chat_templates_apply(tmpls, inputs).prompt.str();
+    if (fmt_new.size() < fmt_past.size()) return fmt_new;
+    ss << fmt_new.substr(fmt_past.size());
+    return ss.str();
+}
