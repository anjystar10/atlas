{
  "name": "atlas-desktop",
  "productName": "Atlas",
  "version": "0.10.2",
  "description": "Atlas, King Anjy's personal AI assistant, on Windows. Synced with Atlas on the phone.",
  "main": "main.js",
  "author": "King Anjy",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --no-warnings --test test/logic.test.mjs test/sync.e2e.mjs test/link.test.mjs test/aware.test.mjs test/trade.test.mjs test/accuracy.test.mjs test/themes.test.mjs test/attach.test.mjs test/finish.test.mjs test/bots2.e2e.test.mjs test/triggers.test.mjs test/templates.test.mjs",
    "test:mail": "node --no-warnings test/mail.e2e.js",
    "test:browser": "electron --no-sandbox test/browser.e2e.js && electron --no-sandbox test/botjob.e2e.js && electron --no-sandbox test/files.e2e.js",
    "test:mcp": "node --no-warnings test/mcp.e2e.js",
    "test:projects": "electron --no-sandbox test/projects.e2e.js",
    "test:link": "node --no-warnings test/link.e2e.mjs",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "smtp-server": "3.21.1"
  },
  "build": {
    "appId": "com.anjy.atlas.desktop",
    "productName": "Atlas",
    "artifactName": "Atlas-Setup.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "pc.js", "botbrowser.js", "botfiles.js", "sheets.js", "device.js", "vault.js", "mcp.js", "trading.js", "tradecore.js", "traderules.js", "brokers.js", "remote.js", "projects.js", "projectrules.js", "mail.js", "mailtext.js", "renderer/**/*", "build/icon.png", "!node_modules/@modelcontextprotocol/sdk/dist/esm/**", "!**/*.map", "!**/*.d.ts"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Atlas", "runAfterFinish": true }
  }
}
