{
  "name": "atlas-desktop",
  "productName": "Atlas",
  "version": "0.9.2",
  "description": "Atlas, King Anjy's personal AI assistant, on Windows. Synced with Atlas on the phone.",
  "main": "main.js",
  "author": "King Anjy",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --no-warnings --test test/logic.test.mjs",
    "test:browser": "electron --no-sandbox test/browser.e2e.js && electron --no-sandbox test/botjob.e2e.js",
    "test:mcp": "node --no-warnings test/mcp.e2e.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.anjy.atlas.desktop",
    "productName": "Atlas",
    "artifactName": "Atlas-Setup.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "pc.js", "botbrowser.js", "device.js", "vault.js", "mcp.js", "renderer/**/*", "build/icon.png", "!node_modules/@modelcontextprotocol/sdk/dist/esm/**", "!**/*.map", "!**/*.d.ts"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Atlas", "runAfterFinish": true }
  }
}
